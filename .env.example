# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key

# GitHub Personal Access Token (required)
# Needs repo scope for reading issues and creating PRs
GITHUB_TOKEN=your-github-token

# Target GitHub Repository in "owner/repo" format (required)
REPO_NAME=owner/repo

# OpenAI Model to use (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Webhook secret for GitHub webhooks (optional)
WEBHOOK_SECRET=your-webhook-secret

# Server port for the webhook server (optional, defaults to 8000)
SERVER_PORT=8000
